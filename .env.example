# Copy to .env and fill in what you need. Every variable is optional for the offline demo;
# unset keys fall back to the heuristic extractor / hashing embedder / fake payments / fixtures.
# Full list: apps/api/src/app/settings.py (prefix APP_).

# --- LLM (Claude) ---------------------------------------------------------------------
APP_LLM_PROVIDER=heuristic            # anthropic | heuristic | local_llama (CPU, optional)
APP_LLM_LOCAL_BASE_URL=http://127.0.0.1:18080
APP_LLM_LOCAL_TIMEOUT_SECONDS=480
APP_ANTHROPIC_API_KEY=
APP_LLM_EXTRACT_MODEL=claude-opus-5
APP_LLM_EXTRACT_EFFORT=low
APP_LLM_BRIEF_EFFORT=medium
APP_LLM_DAILY_BUDGET_USD=25

# --- embeddings -----------------------------------------------------------------------
APP_EMBEDDING_PROVIDER=hashing        # voyage | hashing
APP_VOYAGE_API_KEY=

# --- public data sources (issue keys at each portal) -----------------------------------
APP_CLIK_API_KEY=                     # 국회도서관 지방의정포털 Open API
APP_DATA_GO_KR_SERVICE_KEY=           # 공공데이터포털 (조달청 나라장터 발주계획·사전규격·입찰공고)
APP_LOFIN_API_KEY=                    # 지방재정365

# --- billing (Toss Payments 자동결제) ---------------------------------------------------
APP_PAYMENT_PROVIDER=fake             # toss | fake
APP_TOSS_CLIENT_KEY=
APP_TOSS_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_BILLING_KEY_ENCRYPTION_KEY=

# --- notifications --------------------------------------------------------------------
APP_SMTP_HOST=localhost
APP_SMTP_PORT=1025
APP_SOLAPI_API_KEY=                   # 카카오 알림톡 (Solapi)
APP_SOLAPI_API_SECRET=
APP_KAKAO_PF_ID=
APP_KAKAO_TEMPLATE_ID=
APP_KAKAO_SENDER_NUMBER=

# --- security & observability -----------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=
APP_SENTRY_DSN=
